{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "AutonomousPromotionReport",
  "additionalProperties": false,
  "required": [
    "artifact_type", "schema_version", "producer_version", "run_id", "generated_at", "session_id", "policy_id", "model_status",
    "candidate_count", "published_count", "held_count", "rejected_count", "published_evidence_ids", "items", "validation", "guardrail_check"
  ],
  "properties": {
    "artifact_type": { "const": "autonomous_promotion_report" },
    "schema_version": { "const": "1.0.0" },
    "producer_version": { "type": "string" },
    "run_id": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "session_id": { "type": ["string", "null"] },
    "policy_id": { "type": "string", "minLength": 1 },
    "model_status": { "enum": ["passed", "fallback", "failed", "not_run"] },
    "publication_mode": { "enum": ["review_required", "policy_auto"] },
    "publication_requested": { "type": "boolean" },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "published_count": { "type": "integer", "minimum": 0 },
    "held_count": { "type": "integer", "minimum": 0 },
    "rejected_count": { "type": "integer", "minimum": 0 },
    "published_evidence_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "evidence_id", "topic_id", "branch_id", "scope", "decision", "reasons"],
        "properties": {
          "candidate_id": { "type": "string" },
          "evidence_id": { "type": "string" },
          "topic_id": { "type": ["string", "null"] },
          "branch_id": { "type": ["string", "null"] },
          "scope": { "enum": ["parent", "branch", null] },
          "decision": { "enum": ["published", "held", "rejected"] },
          "reasons": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "validation": { "type": ["object", "null"] },
    "guardrail_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_table_required", "stage_first_score_second", "parent_branch_separation", "no_trading_advice", "provenance_required", "model_validation_required"],
      "properties": {
        "evidence_table_required": { "const": true },
        "stage_first_score_second": { "const": true },
        "parent_branch_separation": { "const": true },
        "no_trading_advice": { "const": true },
        "provenance_required": { "type": "boolean" },
        "model_validation_required": { "type": "boolean" },
        "human_review_required": { "type": "boolean" },
        "automatic_publication_enabled": { "type": "boolean" }
      }
    }
  }
}
