{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthoritativeResearchSourceAtlas",
  "type": "object",
  "additionalProperties": false,
  "required": ["atlas_version", "sources"],
  "properties": {
    "atlas_version": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "display_name_zh", "display_name_en", "operator", "authority_tier", "domains", "coverage_layers", "access_mode", "base_url", "terms_url", "automated_polling_allowed", "review_required", "evidence_ceiling", "topic_discovery_capable", "branch_discovery_capable", "languages"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "display_name_zh": { "type": "string", "minLength": 1 },
          "display_name_en": { "type": "string", "minLength": 1 },
          "operator": { "type": "string", "minLength": 1 },
          "authority_tier": { "enum": ["statutory", "regulator", "intergovernmental", "filing", "academic", "company", "news"] },
          "domains": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "coverage_layers": { "type": "array", "minItems": 1, "items": { "enum": ["name", "capital", "pricing", "reality", "momentum", "friction", "data_confidence"] } },
          "access_mode": { "enum": ["direct_api", "rss_or_html", "search_bridge", "manual_review"] },
          "base_url": { "type": "string", "format": "uri" },
          "terms_url": { "type": "string", "format": "uri" },
          "automated_polling_allowed": { "type": "boolean" },
          "review_required": { "type": "boolean" },
          "evidence_ceiling": { "enum": ["E1", "E2", "E3", "E4"] },
          "topic_discovery_capable": { "type": "boolean" },
          "branch_discovery_capable": { "type": "boolean" },
          "languages": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
