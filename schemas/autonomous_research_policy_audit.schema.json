{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutonomousResearchPolicyAudit",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "producer_version", "generated_at", "policy_id", "status", "automatic_publication_enabled", "errors", "warnings", "guardrail_check"],
  "properties": {
    "artifact_type": { "const": "autonomous_research_policy_audit" },
    "schema_version": { "const": "1.0.0" },
    "producer_version": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "policy_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["passed", "failed"] },
    "automatic_publication_enabled": { "type": "boolean" },
    "errors": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "guardrail_check": { "type": "object", "additionalProperties": false, "required": ["explicit_policy_required", "evidence_table_required_for_stage", "parent_branch_separation", "no_trading_advice"], "properties": { "explicit_policy_required": { "const": true }, "evidence_table_required_for_stage": { "const": true }, "parent_branch_separation": { "const": true }, "no_trading_advice": { "const": true } } }
  }
}
