{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntakeAgentVerificationReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_id", "generated_at", "session_id", "candidate_count", "passed_count", "failed_count", "fallback_count", "candidates", "guardrail_check"],
  "properties": {
    "report_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "session_id": {"type": "string", "minLength": 1},
    "candidate_count": {"type": "integer", "minimum": 0},
    "passed_count": {"type": "integer", "minimum": 0},
    "failed_count": {"type": "integer", "minimum": 0},
    "fallback_count": {"type": "integer", "minimum": 0},
    "candidates": {"type": "array", "items": {"type": "object"}},
    "guardrail_check": {"type": "object", "required": ["schema_validated", "citation_checked", "parent_branch_checked", "stage_not_reclassified", "scoring_not_run", "no_auto_import", "no_trading_advice", "secrets_not_persisted"], "properties": {"schema_validated": {"type": "boolean"}, "citation_checked": {"type": "boolean"}, "parent_branch_checked": {"type": "boolean"}, "stage_not_reclassified": {"type": "boolean"}, "scoring_not_run": {"type": "boolean"}, "no_auto_import": {"type": "boolean"}, "no_trading_advice": {"type": "boolean"}, "secrets_not_persisted": {"type": "boolean"}}, "additionalProperties": false}
  }
}
