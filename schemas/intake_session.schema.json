{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "EvidenceIntakeSession",
  "additionalProperties": false,
  "required": ["session_id", "generated_at", "raw_document", "chunks", "provenance_records", "candidates", "review_template"],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "raw_document": { "type": "object", "additionalProperties": true },
    "chunks": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "provenance_records": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "candidates": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "ai_shadow_candidates": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "candidate_comparisons": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "review_template": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
  }
}
