{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "ProvenanceRecord",
  "additionalProperties": false,
  "required": ["provenance_id", "raw_document_id", "chunk_id", "quote", "quote_start_offset", "quote_end_offset", "location_label", "extraction_reason"],
  "properties": {
    "provenance_id": { "type": "string", "minLength": 1 },
    "raw_document_id": { "type": "string", "minLength": 1 },
    "chunk_id": { "type": "string", "minLength": 1 },
    "quote": { "type": "string", "minLength": 1 },
    "quote_start_offset": { "type": "integer", "minimum": 0 },
    "quote_end_offset": { "type": "integer", "minimum": 0 },
    "location_label": { "type": "string", "minLength": 1 },
    "extraction_reason": { "type": "string", "minLength": 1 }
  }
}
