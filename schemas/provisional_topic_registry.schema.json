{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "title": "ProvisionalTopicRegistry",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["provisional_topic_id", "proposed_name", "source_candidate_id", "created_at", "status", "reason"],
    "properties": {
      "provisional_topic_id": { "type": "string", "minLength": 1 },
      "proposed_name": { "type": "string", "minLength": 1 },
      "source_candidate_id": { "type": "string", "minLength": 1 },
      "created_at": { "type": "string", "format": "date-time" },
      "status": { "enum": ["provisional", "promoted", "rejected"] },
      "reason": { "type": "string", "minLength": 1 }
    }
  }
}
