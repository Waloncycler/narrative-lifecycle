  "properties": {
    "industry_id": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "topic_hints": {"type": "array", "items": {"type": "string"}},
    "branch_hints": {"type": "array", "items": {"type": "string"}},
    "hard_evidence_hints": {"type": "array", "items": {"type": "string"}},
    "forbidden_inferences": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
