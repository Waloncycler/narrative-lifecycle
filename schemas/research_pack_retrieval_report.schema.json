{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchPackRetrievalReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "producer_version", "pack_id", "title", "generated_at", "research_questions", "proposed_taxonomy", "triage", "retrieval", "guardrail_check"],
  "properties": {
    "artifact_type": {"const": "research_pack_retrieval_report"}, "schema_version": {"const": "1.0.0"}, "producer_version": {"type": "string"}, "pack_id": {"type": "string"}, "title": {"type": "string"}, "generated_at": {"type": "string", "format": "date-time"}, "research_questions": {"type": "array", "items": {"type": "string"}}, "proposed_taxonomy": {"type": "object"}, "triage": {"type": "object"}, "retrieval": {"type": "object"},
    "guardrail_check": {"type": "object", "additionalProperties": false, "required": ["source_urls_are_retrieval_targets_not_evidence", "proposed_taxonomy_is_not_auto_registered", "parent_branch_separation", "no_auto_evidence_import", "no_trading_advice"], "properties": {"source_urls_are_retrieval_targets_not_evidence": {"const": true}, "proposed_taxonomy_is_not_auto_registered": {"const": true}, "parent_branch_separation": {"const": true}, "no_auto_evidence_import": {"const": true}, "no_trading_advice": {"const": true}}}
