{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntakeAgentCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_candidate_id", "source_candidate_id", "raw_document_id", "chunk_id", "provenance_id", "original_quote", "quote_start_offset", "quote_end_offset", "supported_fact", "inferred_interpretation", "limitation", "suggested_evidence", "suggested_reason", "uncertainty_notes", "alternative_mappings", "provider", "model_version", "prompt_version", "validation_status", "validation_errors", "fallback_used", "human_review_required"],
  "properties": {
    "agent_candidate_id": {"type": "string", "minLength": 1},
    "source_candidate_id": {"type": "string", "minLength": 1},
    "raw_document_id": {"type": "string", "minLength": 1},
    "chunk_id": {"type": "string", "minLength": 1},
    "provenance_id": {"type": "string", "minLength": 1},
    "original_quote": {"type": "string", "minLength": 1},
    "quote_start_offset": {"type": "integer", "minimum": 0},
    "quote_end_offset": {"type": "integer", "minimum": 1},
    "supported_fact": {"type": "string", "minLength": 1},
    "inferred_interpretation": {"type": "string", "minLength": 1},
    "limitation": {"type": "string", "minLength": 1},
    "suggested_evidence": {"type": "object"},
    "suggested_reason": {"type": "string", "minLength": 1},
    "uncertainty_notes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "alternative_mappings": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["topic_id", "reason"], "properties": {"topic_id": {"type": ["string", "null"]}, "branch_id": {"type": ["string", "null"]}, "scope": {"type": ["string", "null"]}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "chain_relation": {"enum": ["supports", "contradicts", "updates", "duplicates", "branch_only", "fills_gap"]},
    "target_evidence_ids": {"type": "array", "maxItems": 5, "items": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,120}$"}},
    "target_stage_gate": {"enum": ["stable_label", "reality_validation", "pricing_adoption", "capital_confirmation", null]},
    "industry_id": {"type": ["string", "null"]},
    "industry_status": {"enum": ["matched", "provisional", "unresolved"]},
    "provider": {"type": "string"},
    "model_version": {"type": "string"},
    "prompt_version": {"type": "string"},
    "validation_status": {"enum": ["passed", "failed", "fallback"]},
    "validation_errors": {"type": "array", "items": {"type": "string"}},
    "fallback_used": {"type": "boolean"},
    "human_review_required": {"type": "boolean"}
  }
}
