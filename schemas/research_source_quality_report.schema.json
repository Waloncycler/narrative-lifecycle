{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchSourceQualityReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "producer_version", "retrieval_run_id", "generated_at", "requested_count", "retrieved_count", "citation_ready_count", "citation_insufficient_count", "citation_ready_rate", "quote_integrity_rate", "average_source_text_chars", "extractor_counts", "source_class_summary", "reviewed_claim_support_rate", "reviewed_topic_branch_accuracy", "guardrail_check"],
  "properties": {
    "artifact_type": { "const": "research_source_quality_report" },
    "schema_version": { "const": "1.0.0" },
    "producer_version": { "type": "string", "minLength": 1 },
    "retrieval_run_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "requested_count": { "type": "integer", "minimum": 0 },
    "retrieved_count": { "type": "integer", "minimum": 0 },
    "citation_ready_count": { "type": "integer", "minimum": 0 },
    "citation_insufficient_count": { "type": "integer", "minimum": 0 },
    "citation_ready_rate": { "anyOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "const": "insufficient_data" }] },
    "quote_integrity_rate": { "anyOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "const": "insufficient_data" }] },
    "average_source_text_chars": { "anyOf": [{ "type": "number", "minimum": 0 }, { "const": "insufficient_data" }] },
    "extractor_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "source_class_summary": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": false, "required": ["retrieved_count", "citation_ready_count"], "properties": { "retrieved_count": { "type": "integer", "minimum": 0 }, "citation_ready_count": { "type": "integer", "minimum": 0 } } } },
    "reviewed_claim_support_rate": { "const": "pending_human_review" },
    "reviewed_topic_branch_accuracy": { "const": "pending_human_review" },
    "guardrail_check": { "type": "object", "additionalProperties": false, "required": ["metrics_do_not_create_evidence", "claim_support_requires_human_review", "topic_branch_accuracy_requires_human_review", "no_trading_advice"], "properties": { "metrics_do_not_create_evidence": { "const": true }, "claim_support_requires_human_review": { "const": true }, "topic_branch_accuracy_requires_human_review": { "const": true }, "no_trading_advice": { "const": true } } }
  }
}
