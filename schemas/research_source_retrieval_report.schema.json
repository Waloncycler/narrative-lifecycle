{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchSourceRetrievalReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "producer_version", "retrieval_run_id", "generated_at", "triage_id", "requested_count", "retrieved_count", "skipped_count", "failed_count", "items", "guardrail_check"],
  "properties": {
    "artifact_type": { "const": "research_source_retrieval_report" }, "schema_version": { "const": "1.0.0" }, "producer_version": { "type": "string", "minLength": 1 }, "retrieval_run_id": { "type": "string", "minLength": 1 }, "generated_at": { "type": "string", "format": "date-time" }, "triage_id": { "type": ["string", "null"] },
    "requested_count": { "type": "integer", "minimum": 0 }, "retrieved_count": { "type": "integer", "minimum": 0 }, "skipped_count": { "type": "integer", "minimum": 0 }, "failed_count": { "type": "integer", "minimum": 0 },
    "items": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["retrieval_id", "triage_id", "origin_lead_id", "topic_id", "branch_id", "candidate_node_id", "source_class", "disposition", "title", "url", "fetched_at", "status", "http_status", "content_type", "page_title", "excerpts", "content_hash", "error", "evidence_eligibility", "next_action"], "properties": {
      "retrieval_id": { "type": "string" }, "triage_id": { "type": "string" }, "origin_lead_id": { "type": "string" }, "topic_id": { "type": ["string", "null"] }, "branch_id": { "type": ["string", "null"] }, "candidate_node_id": { "type": ["string", "null"] },
      "source_class": { "enum": ["official", "company_primary", "academic", "reference", "community", "secondary", "unknown"] }, "disposition": { "enum": ["priority_review", "review", "reference_only", "hold", "duplicate"] }, "title": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "fetched_at": { "type": "string", "format": "date-time" }, "status": { "enum": ["retrieved", "skipped", "failed"] }, "http_status": { "type": ["integer", "null"] }, "content_type": { "type": ["string", "null"] }, "page_title": { "type": ["string", "null"] }, "content_hash": { "type": ["string", "null"] }, "error": { "type": ["string", "null"] }, "evidence_eligibility": { "const": "context_only" }, "next_action": { "enum": ["prepare_intake", "hold"] },
      "excerpts": { "type": "array", "maxItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["quote", "quote_start_offset", "quote_end_offset", "location_label"], "properties": { "quote": { "type": "string", "minLength": 1, "maxLength": 700 }, "quote_start_offset": { "type": "integer", "minimum": 0 }, "quote_end_offset": { "type": "integer", "minimum": 0 }, "location_label": { "type": "string" } } } }
    } } },
    "guardrail_check": { "type": "object", "additionalProperties": false, "required": ["only_governed_source_classes_requested", "bounded_excerpts_only", "original_url_preserved", "no_auto_evidence_import", "evidence_table_required_for_stage", "parent_branch_separation", "no_trading_advice"], "properties": { "only_governed_source_classes_requested": { "const": true }, "bounded_excerpts_only": { "const": true }, "original_url_preserved": { "const": true }, "no_auto_evidence_import": { "const": true }, "evidence_table_required_for_stage": { "const": true }, "parent_branch_separation": { "const": true }, "no_trading_advice": { "const": true } } }
  }
}
