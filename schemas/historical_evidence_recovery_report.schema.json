{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HistoricalEvidenceRecoveryReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "producer_version", "recovery_plan_id", "generated_at", "timeline_source", "status", "tasks", "summary", "guardrail_check"],
  "properties": {
    "artifact_type": {"const": "historical_evidence_recovery_report"},
    "schema_version": {"const": "1.0.0"},
    "producer_version": {"type": "string", "minLength": 1},
    "recovery_plan_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "timeline_source": {"const": "stage_evolution_timeline"},
    "status": {"enum": ["ready_for_research", "insufficient_history"]},
    "tasks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["task_id", "kind", "priority", "topic_id", "topic_name", "scope", "target_stages", "required_layers", "accepted_source_classes", "search_intents", "rationale", "intake_route", "evidence_eligibility"], "properties": {"task_id": {"type": "string"}, "kind": {"enum": ["fill_stage_gap", "establish_parent_baseline", "repair_provenance"]}, "priority": {"enum": ["high", "medium"]}, "topic_id": {"type": "string"}, "topic_name": {"type": "string"}, "scope": {"const": "parent"}, "target_stages": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "required_layers": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "accepted_source_classes": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "search_intents": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "rationale": {"type": "string"}, "intake_route": {"const": "research_retrieve_then_intake_review"}, "evidence_eligibility": {"const": "context_only"}}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["topic_count", "task_count", "stage_gap_task_count", "baseline_task_count", "provenance_repair_task_count", "high_priority_count"], "properties": {"topic_count": {"type": "integer", "minimum": 0}, "task_count": {"type": "integer", "minimum": 0}, "stage_gap_task_count": {"type": "integer", "minimum": 0}, "baseline_task_count": {"type": "integer", "minimum": 0}, "provenance_repair_task_count": {"type": "integer", "minimum": 0}, "high_priority_count": {"type": "integer", "minimum": 0}}},
    "guardrail_check": {"type": "object", "additionalProperties": false, "required": ["timeline_is_read_only", "existing_stage_unchanged", "no_auto_evidence_import", "evidence_table_required_for_stage", "parent_branch_separation", "no_auto_registry_mutation", "no_trading_advice"], "properties": {"timeline_is_read_only": {"const": true}, "existing_stage_unchanged": {"const": true}, "no_auto_evidence_import": {"const": true}, "evidence_table_required_for_stage": {"const": true}, "parent_branch_separation": {"const": true}, "no_auto_registry_mutation": {"const": true}, "no_trading_advice": {"const": true}}}
  }
}
