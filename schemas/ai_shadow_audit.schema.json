{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "AiShadowAuditRecord",
  "additionalProperties": false,
  "required": ["audit_id", "generated_at", "session_id", "provider", "model_version", "prompt_version", "status", "candidate_count", "fallback_count", "invalid_count", "request_fingerprints", "response_fingerprints", "errors", "secret_redaction"],
  "properties": {
    "audit_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "session_id": { "type": "string", "minLength": 1 },
    "provider": { "type": "string" },
    "model_version": { "type": "string" },
    "prompt_version": { "type": "string" },
    "status": { "enum": ["passed", "fallback", "failed"] },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "fallback_count": { "type": "integer", "minimum": 0 },
    "invalid_count": { "type": "integer", "minimum": 0 },
    "request_fingerprints": { "type": "array", "items": { "type": "string" } },
    "response_fingerprints": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } },
    "secret_redaction": { "const": "api_key_not_persisted" }
  }
}
