{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceChainEntry",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "producer_version", "chain_entry_id", "generated_at", "topic_id", "branch_id", "scope", "evidence_id", "source_candidate_id", "provenance_id", "relation", "prior_evidence_ids", "affected_stage_gate", "why_not_higher_before", "source_quote", "status", "idempotency_key", "run_id"],
  "properties": {
    "artifact_type": {"const": "evidence_chain_entry"},
    "schema_version": {"const": "1.0.0"},
    "producer_version": {"type": "string"},
    "chain_entry_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "topic_id": {"type": "string", "minLength": 1},
    "branch_id": {"type": ["string", "null"]},
    "scope": {"enum": ["parent", "branch"]},
    "evidence_id": {"type": "string", "minLength": 1},
    "source_candidate_id": {"type": ["string", "null"]},
    "provenance_id": {"type": ["string", "null"]},
    "relation": {"enum": ["supports", "contradicts", "updates", "duplicates", "branch_only", "fills_gap"]},
    "prior_evidence_ids": {"type": "array", "items": {"type": "string"}},
    "affected_stage_gate": {"type": ["string", "null"]},
    "why_not_higher_before": {"type": ["string", "null"]},
    "source_quote": {"type": "string"},
    "status": {"enum": ["candidate", "confirmed", "rejected"]},
    "idempotency_key": {"type": "string", "minLength": 1},
    "run_id": {"type": ["string", "null"]},
    "operator_decision": {"type": "object", "required": ["reviewer", "decided_at"], "properties": {"reviewer": {"type": "string", "minLength": 1}, "decided_at": {"type": "string", "format": "date-time"}, "note": {"type": "string"}}, "additionalProperties": false}
  }
}
