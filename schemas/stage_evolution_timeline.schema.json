{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StageEvolutionTimeline",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "topic_id",
      "topic_name",
      "first_emergence_date",
      "first_available_at",
      "current_stage",
      "total_evidence_count",
      "eligible_parent_evidence_count",
      "excluded_evidence",
      "history_status",
      "history_status_reason",
      "transitions",
      "evolution_path",
      "evidence_timeline"
    ],
    "properties": {
      "topic_id": { "type": "string", "minLength": 1 },
      "topic_name": { "type": "string", "minLength": 1 },
      "first_emergence_date": { "type": "string", "minLength": 1 },
      "first_available_at": { "type": "string", "minLength": 1 },
      "current_stage": { "type": "string", "enum": ["S0", "S1", "S2", "S3", "S4", "S5", "S6"] },
      "total_evidence_count": { "type": "integer", "minimum": 0 },
      "eligible_parent_evidence_count": { "type": "integer", "minimum": 0 },
      "excluded_evidence": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_id", "reason"],
          "properties": {
            "evidence_id": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "enum": ["missing_provenance", "unverified_historical_backfill", "invalid_chronology"] }
          }
        }
      },
      "history_status": { "type": "string", "enum": ["verified", "partial", "insufficient", "no_parent_evidence"] },
      "history_status_reason": { "type": "string", "minLength": 1 },
      "transitions": { "type": "array" },
      "evolution_path": { "type": "string", "minLength": 1 },
      "evidence_timeline": { "type": "array" }
    }
  }
}
