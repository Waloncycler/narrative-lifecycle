# Narrative Lifecycle — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Run Mode ─────────────────────────────────────────────────────────────────
# Options: research | test | (unset = unlabelled)
NARRATIVE_RUN_MODE=research

# ── AI Agent Provider (DeepSeek or MiniMax) ───────────────────────────────────
# Set one provider key to enable the AI candidate analysis layer.
# Leave blank to use rule-based fallback only.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# ── Generic NARRATIVE_AGENT overrides (advanced) ──────────────────────────────
# These override auto-detection above. Only set if using a custom endpoint.
NARRATIVE_AGENT_PROVIDER=
NARRATIVE_AGENT_ENDPOINT=
NARRATIVE_AGENT_API_KEY=
NARRATIVE_AGENT_MODEL=
NARRATIVE_AGENT_TIMEOUT_MS=600000

# ── Web Discovery / Historical Provenance Recovery ───────────────────────────
# Default `free` aggregates bounded, keyless public indexes (including Bing
# RSS). Results only find
# possible original pages; the system fetches and quotes the source page before
# it can enter Intake. For a self-hosted MCP/search gateway, set mcp_bridge and
# provide the gateway endpoint/key. Secrets are never written to artifacts.
NARRATIVE_WEB_SEARCH_PROVIDER=free
# NARRATIVE_WEB_SEARCH_ENDPOINT=
# NARRATIVE_WEB_SEARCH_API_KEY=
NARRATIVE_WEB_SEARCH_TIMEOUT_MS=15000
NARRATIVE_WEB_SEARCH_MAX_RESULTS=8

# ── WorldMonitor Feed Settings ────────────────────────────────────────────────
# Optional: override the default User-Agent for feed fetching
# WORLDMONITOR_USER_AGENT_OVERRIDE=Mozilla/5.0 (compatible; NarrativeBot/1.0)

# Optional: HTTP proxy for regions where feeds are rate-limited
# WORLDMONITOR_PROXY_URL=http://127.0.0.1:7890

# ── Workbench Server ──────────────────────────────────────────────────────────
# Default: 4177, bound to 127.0.0.1 only
# WORKBENCH_PORT=4177
