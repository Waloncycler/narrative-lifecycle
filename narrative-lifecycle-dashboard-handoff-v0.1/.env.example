# Narrative Lifecycle — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Run Mode ─────────────────────────────────────────────────────────────────
# Options: research | test | (unset = unlabelled)
NARRATIVE_RUN_MODE=research

# ── AI Agent Provider (MiniMax) ───────────────────────────────────────────────
# Set MINIMAX_API_KEY to enable the AI candidate shadow validation layer.
# Leave blank to use rule-based fallback only.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# ── Generic NARRATIVE_AGENT overrides (advanced) ──────────────────────────────
# These override auto-detection above. Only set if using a custom endpoint.
NARRATIVE_AGENT_PROVIDER=
NARRATIVE_AGENT_ENDPOINT=
NARRATIVE_AGENT_API_KEY=
NARRATIVE_AGENT_MODEL=
NARRATIVE_AGENT_TIMEOUT_MS=600000

# ── WorldMonitor Feed Settings ────────────────────────────────────────────────
# Optional: override the default User-Agent for feed fetching
# WORLDMONITOR_USER_AGENT_OVERRIDE=Mozilla/5.0 (compatible; NarrativeBot/1.0)

# Optional: HTTP proxy for regions where feeds are rate-limited
# WORLDMONITOR_PROXY_URL=http://127.0.0.1:7890

# ── Workbench Server ──────────────────────────────────────────────────────────
# Default: 4177, bound to 127.0.0.1 only
# WORKBENCH_PORT=4177
