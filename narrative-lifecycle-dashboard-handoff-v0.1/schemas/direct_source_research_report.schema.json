{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DirectSourceResearchReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "producer_version", "research_id", "generated_at", "status", "queries", "lead_count", "leads", "guardrail_check"],
  "properties": {
    "artifact_type": { "const": "direct_source_research_report" },
    "schema_version": { "const": "1.0.0" },
    "producer_version": { "type": "string", "minLength": 1 },
    "research_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["completed", "degraded", "insufficient_coverage"] },
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query_id", "task_id", "source_id", "source_name", "query", "status", "result_count", "error"],
        "properties": {
          "query_id": { "type": "string" },
          "task_id": { "type": "string" },
          "source_id": { "type": "string" },
          "source_name": { "type": "string" },
          "query": { "type": "string" },
          "status": { "enum": ["completed", "skipped", "failed"] },
          "result_count": { "type": "integer", "minimum": 0 },
          "error": { "type": ["string", "null"] }
        }
      }
    },
    "lead_count": { "type": "integer", "minimum": 0 },
    "leads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lead_id", "task_id", "topic_id", "branch_id", "source_id", "source_name", "title", "url", "snippet", "published_at", "evidence_eligibility", "next_action"],
        "properties": {
          "lead_id": { "type": "string" },
          "task_id": { "type": "string" },
          "topic_id": { "type": ["string", "null"] },
          "branch_id": { "type": ["string", "null"] },
          "candidate_node_id": { "type": ["string", "null"] },
          "source_id": { "type": "string" },
          "source_name": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "snippet": { "type": "string" },
          "published_at": { "type": ["string", "null"] },
          "evidence_eligibility": { "const": "context_only" },
          "next_action": { "const": "review_source" }
        }
      }
    },
    "guardrail_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct_source_results_not_formal_evidence", "original_source_url_required", "evidence_table_required_for_stage", "parent_branch_separation", "no_auto_import", "no_trading_advice"],
      "properties": {
        "direct_source_results_not_formal_evidence": { "const": true },
        "original_source_url_required": { "const": true },
        "evidence_table_required_for_stage": { "const": true },
        "parent_branch_separation": { "const": true },
        "no_auto_import": { "const": true },
        "no_trading_advice": { "const": true }
      }
    }
  }
}
