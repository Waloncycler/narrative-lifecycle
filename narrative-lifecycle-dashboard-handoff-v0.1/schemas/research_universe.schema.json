{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchUniverse",
  "type": "object",
  "additionalProperties": false,
  "required": ["universe_version", "nodes"],
  "properties": {
    "universe_version": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "display_name_zh", "display_name_en", "aliases", "domain", "priority", "suggested_branch_names", "target_layers", "preferred_source_ids"],
        "properties": {
          "node_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "display_name_zh": { "type": "string", "minLength": 2 },
          "display_name_en": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "domain": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
          "suggested_branch_names": { "type": "array", "items": { "type": "string" } },
          "target_layers": { "type": "array", "minItems": 1, "items": { "enum": ["name", "capital", "pricing", "reality", "momentum", "friction", "data_confidence"] } },
          "preferred_source_ids": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } }
        }
      }
    }
  }
}
