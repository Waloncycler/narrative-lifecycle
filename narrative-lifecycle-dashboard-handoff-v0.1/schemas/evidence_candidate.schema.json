{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "EvidenceCandidate",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "raw_document_id",
    "chunk_id",
    "provenance_id",
    "original_quote",
    "suggested_evidence",
    "suggested_reason",
    "uncertainty_notes",
    "field_explanations",
    "e_strength_rationale",
    "guardrail_check"
  ],
  "properties": {
    "candidate_id": { "type": "string", "minLength": 1 },
    "raw_document_id": { "type": "string", "minLength": 1 },
    "chunk_id": { "type": "string", "minLength": 1 },
    "provenance_id": { "type": "string", "minLength": 1 },
    "original_quote": { "type": "string", "minLength": 1 },
    "suggested_evidence": { "type": "object", "additionalProperties": true },
    "suggested_reason": { "type": "string", "minLength": 1 },
    "uncertainty_notes": { "type": "array", "items": { "type": "string" } },
    "field_explanations": { "type": "object", "additionalProperties": { "type": "string" } },
    "e_strength_rationale": { "type": "string", "minLength": 1 },
    "publication_eligibility": { "enum": ["manual_review", "rule_verified"] },
    "duplicate_of_evidence_id": { "type": ["string", "null"] },
    "provider": { "type": "string" },
    "model_version": { "type": "string" },
    "prompt_version": { "type": "string" },
    "validation_status": { "enum": ["passed", "failed", "fallback"] },
    "validation_errors": { "type": "array", "items": { "type": "string" } },
    "guardrail_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["no_trading_advice", "provenance_present", "human_review_required"],
      "properties": {
        "no_trading_advice": { "type": "boolean" },
        "provenance_present": { "type": "boolean" },
        "human_review_required": { "type": "boolean" }
      }
    }
  }
}
