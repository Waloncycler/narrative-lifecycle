{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntakeLearningProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "profile_version", "generated_at", "source_evaluation_ids", "observed_session_count", "observed_candidate_count", "field_corrections", "topic_corrections", "rejection_patterns", "split_count", "guardrail_incidents", "adaptation_mode", "auto_rule_mutation", "auto_stage_change", "auto_topic_activation"],
  "properties": {
    "profile_id": {"type": "string", "minLength": 1},
    "profile_version": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_evaluation_ids": {"type": "array", "items": {"type": "string"}},
    "observed_session_count": {"type": "integer", "minimum": 0},
    "observed_candidate_count": {"type": "integer", "minimum": 0},
    "field_corrections": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["field", "correction_count", "example_candidate_ids"], "properties": {"field": {"type": "string"}, "correction_count": {"type": "integer", "minimum": 0}, "example_candidate_ids": {"type": "array", "items": {"type": "string"}}}}},
    "topic_corrections": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from_topic_id", "to_topic_id", "from_branch_id", "to_branch_id", "count", "example_candidate_ids"], "properties": {"from_topic_id": {"type": ["string", "null"]}, "to_topic_id": {"type": ["string", "null"]}, "from_branch_id": {"type": ["string", "null"]}, "to_branch_id": {"type": ["string", "null"]}, "count": {"type": "integer", "minimum": 0}, "example_candidate_ids": {"type": "array", "items": {"type": "string"}}}}},
    "rejection_patterns": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["reason", "count", "example_candidate_ids"], "properties": {"reason": {"type": "string"}, "count": {"type": "integer", "minimum": 0}, "example_candidate_ids": {"type": "array", "items": {"type": "string"}}}}},
    "split_count": {"type": "integer", "minimum": 0},
    "guardrail_incidents": {"type": "object", "additionalProperties": false, "required": ["parent_branch_errors", "duplicate_hits", "trading_advice_attempts"], "properties": {"parent_branch_errors": {"type": "integer", "minimum": 0}, "duplicate_hits": {"type": "integer", "minimum": 0}, "trading_advice_attempts": {"type": "integer", "minimum": 0}}},
    "adaptation_mode": {"enum": ["advisory_only", "autonomous"]},
    "auto_rule_mutation": {"type": "boolean"},
    "auto_stage_change": {"type": "boolean"},
    "auto_topic_activation": {"type": "boolean"}
  }
}
