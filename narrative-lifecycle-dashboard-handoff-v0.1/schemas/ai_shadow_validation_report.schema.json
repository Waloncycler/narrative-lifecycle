{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "AiShadowValidationReport",
  "additionalProperties": false,
  "required": ["report_id", "generated_at", "baseline_version", "document_count", "rule_only_candidate_count", "ai_candidate_count", "fallback_count", "invalid_output_count", "precision", "recall", "unsupported_claim_rate", "citation_accuracy", "topic_branch_accuracy", "e3_e4_overstatement_count", "average_review_time_seconds", "field_modification_rate", "final_user_selection", "guardrail_check"],
  "properties": {
    "report_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "baseline_version": { "const": "v0.5.6-rule-baseline" },
    "document_count": { "type": "integer", "minimum": 0 },
    "rule_only_candidate_count": { "type": "integer", "minimum": 0 },
    "ai_candidate_count": { "type": "integer", "minimum": 0 },
    "fallback_count": { "type": "integer", "minimum": 0 },
    "invalid_output_count": { "type": "integer", "minimum": 0 },
    "precision": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "const": "pending_human_review" }] },
    "recall": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "const": "pending_human_review" }] },
    "unsupported_claim_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "citation_accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
    "topic_branch_accuracy": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "const": "pending_human_review" }] },
    "e3_e4_overstatement_count": { "type": "integer", "minimum": 0 },
    "average_review_time_seconds": { "oneOf": [{ "type": "number", "minimum": 0 }, { "const": "insufficient_data" }] },
    "field_modification_rate": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "const": "pending_human_review" }] },
    "final_user_selection": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "guardrail_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_validated", "citation_checked", "parent_branch_checked", "e_strength_checked", "no_trading_advice", "fallback_to_rule_based", "secrets_not_persisted"],
      "properties": {
        "schema_validated": { "type": "boolean" },
        "citation_checked": { "type": "boolean" },
        "parent_branch_checked": { "type": "boolean" },
        "e_strength_checked": { "type": "boolean" },
        "no_trading_advice": { "type": "boolean" },
        "fallback_to_rule_based": { "type": "boolean" },
        "secrets_not_persisted": { "type": "boolean" }
      }
    }
  }
}
