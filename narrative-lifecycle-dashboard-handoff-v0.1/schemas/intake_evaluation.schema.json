{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "IntakeEvaluationReport",
  "additionalProperties": false,
  "required": [
    "evaluation_id",
    "generated_at",
    "session_id",
    "candidate_count",
    "acceptance_rate",
    "modification_rate",
    "rejection_rate",
    "split_rate",
    "field_accuracy",
    "average_review_time_seconds",
    "duplicate_prevention_count",
    "parent_branch_error_rate",
    "ai_shadow_difference_count",
    "feedback",
    "unresolved_candidate_ids",
    "guardrail_check"
  ],
  "properties": {
    "evaluation_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "session_id": { "type": "string", "minLength": 1 },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "acceptance_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "modification_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "rejection_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "split_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "field_accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
    "average_review_time_seconds": { "oneOf": [{ "type": "number", "minimum": 0 }, { "const": "insufficient_data" }] },
    "duplicate_prevention_count": { "type": "integer", "minimum": 0 },
    "parent_branch_error_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "ai_shadow_difference_count": { "type": "integer", "minimum": 0 },
    "feedback": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "final_decision", "modified_fields", "review_duration_seconds", "duplicate_hit", "parent_branch_error", "field_accuracy"],
        "properties": {
          "candidate_id": { "type": "string", "minLength": 1 },
          "final_decision": { "enum": ["accept", "modify", "reject", "split"] },
          "modified_fields": { "type": "array", "items": { "type": "string" } },
          "rejection_reason": { "type": ["string", "null"] },
          "review_duration_seconds": { "type": ["number", "null"], "minimum": 0 },
          "duplicate_hit": { "type": "boolean" },
          "parent_branch_error": { "type": "boolean" },
          "field_accuracy": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "unresolved_candidate_ids": { "type": "array", "items": { "type": "string" } },
    "guardrail_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_review_required", "no_trading_advice", "ai_shadow_only", "no_auto_topic_activation"],
      "properties": {
        "human_review_required": { "type": "boolean" },
        "no_trading_advice": { "type": "boolean" },
        "ai_shadow_only": { "type": "boolean" },
        "no_auto_topic_activation": { "type": "boolean" }
      }
    }
  }
}
