{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchCampaign",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "producer_version", "campaign_id", "generated_at", "source_atlas_version", "universe_version", "tasks", "summary", "guardrail_check"],
  "properties": {
    "artifact_type": { "const": "research_campaign" },
    "schema_version": { "const": "1.0.0" },
    "producer_version": { "type": "string", "minLength": 1 },
    "campaign_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_atlas_version": { "type": "string" },
    "universe_version": { "type": "string" },
    "tasks": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["task_id", "node_kind", "topic_id", "branch_id", "candidate_node_id", "display_name_zh", "display_name_en", "domain", "priority", "target_layers", "query", "source_ids", "source_domains", "direct_operation_ids", "rationale", "formal_status"], "properties": { "task_id": { "type": "string" }, "node_kind": { "enum": ["formal_topic", "provisional_topic", "universe_seed", "branch"] }, "topic_id": { "type": ["string", "null"] }, "branch_id": { "type": ["string", "null"] }, "candidate_node_id": { "type": ["string", "null"] }, "display_name_zh": { "type": "string" }, "display_name_en": { "type": ["string", "null"] }, "domain": { "type": "string" }, "priority": { "type": "integer" }, "target_layers": { "type": "array", "items": { "enum": ["name", "capital", "pricing", "reality", "momentum", "friction", "data_confidence"] } }, "query": { "type": "string" }, "source_ids": { "type": "array", "items": { "type": "string" } }, "source_domains": { "type": "array", "items": { "type": "string" } }, "company_targets": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["company_id", "display_name_zh", "display_name_en", "market", "official_source_url", "disclosure_source_ids"], "properties": { "company_id": { "type": "string" }, "display_name_zh": { "type": "string" }, "display_name_en": { "type": "string" }, "market": { "enum": ["china", "hong_kong", "us", "global", "private"] }, "official_source_url": { "type": "string", "format": "uri" }, "disclosure_source_ids": { "type": "array", "items": { "type": "string" } } } } }, "direct_operation_ids": { "type": "array", "items": { "type": "string" } }, "rationale": { "type": "string" }, "formal_status": { "enum": ["formal", "provisional", "research_seed", "watch_branch"] } } } },
    "summary": { "type": "object", "additionalProperties": false, "required": ["formal_topic_count", "provisional_topic_count", "universe_seed_count", "branch_count", "source_target_count", "task_count", "skipped_unresolved_branch_count"], "properties": { "formal_topic_count": { "type": "integer", "minimum": 0 }, "provisional_topic_count": { "type": "integer", "minimum": 0 }, "universe_seed_count": { "type": "integer", "minimum": 0 }, "branch_count": { "type": "integer", "minimum": 0 }, "source_target_count": { "type": "integer", "minimum": 0 }, "task_count": { "type": "integer", "minimum": 0 }, "skipped_unresolved_branch_count": { "type": "integer", "minimum": 0 } } },
    "guardrail_check": { "type": "object", "additionalProperties": false, "required": ["research_seeds_are_not_formal_topics", "source_capability_is_not_connectivity_claim", "search_results_remain_context_only", "parent_branch_separation", "evidence_table_required_for_stage", "no_auto_import", "no_trading_advice"], "properties": { "research_seeds_are_not_formal_topics": { "const": true }, "source_capability_is_not_connectivity_claim": { "const": true }, "search_results_remain_context_only": { "const": true }, "parent_branch_separation": { "const": true }, "evidence_table_required_for_stage": { "const": true }, "no_auto_import": { "const": true }, "no_trading_advice": { "const": true } } }
  }
}
