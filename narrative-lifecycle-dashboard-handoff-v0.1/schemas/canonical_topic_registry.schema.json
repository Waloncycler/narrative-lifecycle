{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "title": "CanonicalTopicRegistry",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["topic_id", "topic_name", "current_stage", "status"],
    "properties": {
      "topic_id": { "type": "string", "minLength": 1 },
      "topic_name": { "type": "string", "minLength": 1 },
      "current_stage": { "type": "string" },
      "status": { "enum": ["active", "archived", "provisional"] },
      "market_name_zh": { "type": "string", "minLength": 1 },
      "market_name_en": { "type": "string", "minLength": 1 },
      "naming_status": { "enum": ["verified", "provisional", "unresolved"] },
      "naming_sources": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_name", "source_url", "available_at", "source_quote"],
          "properties": {
            "source_name": { "type": "string", "minLength": 1 },
            "source_url": { "type": "string", "format": "uri" },
            "available_at": { "type": "string", "format": "date" },
            "source_quote": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
