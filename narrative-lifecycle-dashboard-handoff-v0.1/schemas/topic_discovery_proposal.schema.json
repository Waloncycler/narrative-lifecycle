{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TopicDiscoveryProposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "producer_version", "proposal_id", "generated_at", "session_id", "kind", "status", "proposed_topic_id", "proposed_topic_name", "parent_topic_id", "proposed_branch_id", "proposed_branch_name", "confidence", "reason", "uncertainty_notes", "alternatives", "narrative_memory_match", "evidence_refs", "audit_required"],
  "properties": {
    "artifact_type": {"const": "topic_discovery_proposal"},
    "schema_version": {"const": "1.0.0"},
    "producer_version": {"type": "string"},
    "proposal_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "session_id": {"type": ["string", "null"]},
    "kind": {"enum": ["new_topic", "new_branch", "alias_of", "reactivation", "unresolved"]},
    "status": {"enum": ["pending", "accepted", "rejected", "deferred"]},
    "proposed_topic_id": {"type": ["string", "null"]},
    "proposed_topic_name": {"type": ["string", "null"]},
    "parent_topic_id": {"type": ["string", "null"]},
    "proposed_branch_id": {"type": ["string", "null"]},
    "proposed_branch_name": {"type": ["string", "null"]},
    "confidence": {"enum": ["low", "medium", "high"]},
    "reason": {"type": "string"},
    "uncertainty_notes": {"type": "array", "items": {"type": "string"}},
    "alternatives": {"type": "array", "items": {"type": "object"}},
    "narrative_memory_match": {"type": "boolean"},
    "evidence_refs": {"type": "array", "items": {"type": "object", "required": ["candidate_id", "quote", "provenance_id", "evidence_id"], "properties": {"candidate_id": {"type": "string"}, "quote": {"type": "string"}, "provenance_id": {"type": "string"}, "evidence_id": {"type": ["string", "null"]}}, "additionalProperties": false}},
    "audit_required": {"const": true},
    "operator_decision": {"type": "object"}
  }
}
