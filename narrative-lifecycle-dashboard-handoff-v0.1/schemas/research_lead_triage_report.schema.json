{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchLeadTriageReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "producer_version", "triage_id", "generated_at", "web_research_id", "direct_research_id", "input_lead_count", "triaged_lead_count", "summary", "items", "guardrail_check"],
  "properties": {
    "artifact_type": { "const": "research_lead_triage_report" },
    "schema_version": { "const": "1.0.0" },
    "producer_version": { "type": "string", "minLength": 1 },
    "triage_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "web_research_id": { "type": ["string", "null"] },
    "direct_research_id": { "type": ["string", "null"] },
    "input_lead_count": { "type": "integer", "minimum": 0 },
    "triaged_lead_count": { "type": "integer", "minimum": 0 },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["priority_review_count", "review_count", "reference_only_count", "hold_count", "duplicate_count", "official_or_academic_count"],
      "properties": {
        "priority_review_count": { "type": "integer", "minimum": 0 }, "review_count": { "type": "integer", "minimum": 0 },
        "reference_only_count": { "type": "integer", "minimum": 0 }, "hold_count": { "type": "integer", "minimum": 0 },
        "duplicate_count": { "type": "integer", "minimum": 0 }, "official_or_academic_count": { "type": "integer", "minimum": 0 }
      }
    },
    "items": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["triage_id", "origin", "origin_lead_id", "duplicate_origin_lead_ids", "topic_id", "branch_id", "candidate_node_id", "title", "url", "source_name", "source_domain", "snippet", "published_at", "retrieved_at", "source_class", "relevance", "freshness", "priority_score", "priority", "disposition", "reasons", "next_action", "evidence_eligibility"],
        "properties": {
          "triage_id": { "type": "string" }, "origin": { "enum": ["web", "direct"] }, "origin_lead_id": { "type": "string" }, "duplicate_origin_lead_ids": { "type": "array", "items": { "type": "string" } },
          "topic_id": { "type": ["string", "null"] }, "branch_id": { "type": ["string", "null"] }, "candidate_node_id": { "type": ["string", "null"] },
          "title": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "source_name": { "type": "string" }, "source_domain": { "type": "string" }, "snippet": { "type": "string" },
          "published_at": { "type": ["string", "null"] }, "retrieved_at": { "type": "string", "format": "date-time" },
          "source_class": { "enum": ["official", "company_primary", "academic", "reference", "community", "secondary", "unknown"] },
          "relevance": { "enum": ["explicit", "contextual", "unverified"] }, "freshness": { "enum": ["fresh", "recent", "archive", "undated"] },
          "priority_score": { "type": "number", "minimum": 0, "maximum": 100 }, "priority": { "enum": ["high", "medium", "low"] },
          "disposition": { "enum": ["priority_review", "review", "reference_only", "hold", "duplicate"] }, "reasons": { "type": "array", "items": { "type": "string" } },
          "next_action": { "enum": ["review_original", "retrieve_primary_source", "validate_market_name", "hold"] }, "evidence_eligibility": { "const": "context_only" }
        }
      }
    },
    "guardrail_check": {
      "type": "object", "additionalProperties": false,
      "required": ["input_results_remain_context_only", "no_auto_evidence_import", "evidence_table_required_for_stage", "parent_branch_separation", "no_trading_advice"],
      "properties": {
        "input_results_remain_context_only": { "const": true }, "no_auto_evidence_import": { "const": true }, "evidence_table_required_for_stage": { "const": true }, "parent_branch_separation": { "const": true }, "no_trading_advice": { "const": true }
      }
    }
  }
}
